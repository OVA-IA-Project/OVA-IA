# ─────────────────────────────────────────────────────────────
# OVA-IA · variables de entorno
# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube al repositorio (.gitignore lo excluye).
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
# Son valores públicos (la seguridad la garantiza RLS, no el secreto).
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key-publica"

# ─────────────────────────────────────────────────────────────
# Las siguientes variables NO van en el frontend.
# Se configuran como secretos en Supabase:
#   supabase secrets set OPENROUTER_API_KEY=... OPENROUTER_MODEL=...
# ─────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="openai/gpt-4o-mini"
